{
  "expo": {
    "name": "Cocomia",
    "slug": "karenda",
    "owner": "cocomia",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cocomia.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ja"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7a4f9a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cocomia.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "予定が体調の時期と重なっていないかを、この端末の中だけで確認するために使います。予定を外部に送ることはありません。",
          "remindersPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f7f6f9",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#17141c"
          }
        }
      ],
      "expo-system-ui",
      "expo-font",
      "expo-asset"
    ],
    "backgroundColor": "#f7f6f9",
    "locales": {
      "ja": "./locales/ja.json"
    },
    "extra": {
      "eas": {
        "projectId": "82ff43d4-4eb7-4f1b-bf63-11e097d48265"
      }
    }
  }
}
