{
  "enabledPlugins": {
    "diagram-design@diagram-design": false,
    "frontend-slides@frontend-slides": false,
    "genjutsu@genjutsu": false,
    "hallmark@hallmark": false,
    "last30days@last30days-skill": false,
    "taste-skill@taste-skill": false
  },
  "skillOverrides": {
    "scrapling": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/factGate.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/factGate.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
